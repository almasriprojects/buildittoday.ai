# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- dependencies / build output ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# --- local tooling ---
.vercel
.turbo
coverage/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- generated media / scratch work ---
# Demo images and video montages live in Supabase Storage, not the repo.
brain_v2_out/
category_photos/
*.mp4
*.png
*.jpg
*.jpeg
# Anchored at any depth. These were "!public/**" which resolves from the
# repository root, and the application lives in frontend/ — so the un-ignore
# never matched and frontend/public/images/hero-photo.png was silently absent
# from every deploy. The homepage requested it and got a 404.
!**/public/**/*.png
!**/public/**/*.jpg
!**/public/**/*.jpeg
!**/public/**/*.svg

# supabase CLI local state
**/supabase/.temp/

# Pipeline run scratch — intermediate media and JSON, regenerated per run
pipeline/_work/
pipeline/__pycache__/
